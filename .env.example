# ─────────────────────────────────────────────────────────────────────────────
# CertiFlow — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Get from: https://console.neon.tech → Project → Connection Details
# Format  : postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-your-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Redis & Celery ───────────────────────────────────────────────────────────
# For local dev: redis://localhost:6379/0
# For Docker   : redis://redis:6379/0  (set automatically by compose)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────────────────
# "local" for filesystem, "s3" for S3-compatible object storage
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage_data

# ── AWS / Cloudflare R2 / S3 (only when STORAGE_TYPE=s3) ────────────────────
S3_BUCKET_NAME=certiflow-certificates
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1

# ── Certificate Defaults ─────────────────────────────────────────────────────
DEFAULT_ISSUER=CertiFlow Academy
DEFAULT_ORGANIZATION=Global Certifications Institute

# Neon PostgreSQL Database URL
# Example: postgresql+psycopg://username:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./certiflow.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage: "local" or "s3"
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage_data

# AWS / Cloudflare R2 / S3 Object Storage (if STORAGE_TYPE=s3)
S3_BUCKET_NAME=certiflow-certificates
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1

# Organization Defaults
DEFAULT_ISSUER=CertiFlow Academy
DEFAULT_ORGANIZATION=Global Certifications Institute
